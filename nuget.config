<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Somente a origem oficial nuget.org: mitiga ataques de "dependency confusion" -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
