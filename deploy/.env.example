# Copie para deploy/.env (NÃO versionado) e preencha:
#   cp deploy/.env.example deploy/.env
#
# Senha do PostgreSQL — OBRIGATÓRIA (o Compose não sobe com valor vazio).
# Gere com: openssl rand -base64 24
# Atenção: a imagem do PostgreSQL só lê esta senha na PRIMEIRA criação do volume.
POSTGRES_PASSWORD=

# Swagger em Production fica desligado. Use "true" apenas na demonstração local.
SWAGGER_ENABLED=false

# Porta local da API (somente 127.0.0.1).
API_PORT=8080
